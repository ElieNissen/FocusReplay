{
  "name": "focus-replay",
  "version": "0.8.4",
  "private": true,
  "description": "A private, local-first workday recorder. Start, work, rewind.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "author": "FocusReplay contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElieNissen/FocusReplay.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "check:privacy": "node scripts/privacy-check.mjs",
    "dist": "npm run build && node scripts/prepare-licenses.mjs && electron-builder --win nsis --config.forceCodeSigning=true --publish never && npm run verify:release",
    "verify:release": "node scripts/verify-windows-release.mjs",
    "dist:unsigned": "npm run build && node scripts/prepare-licenses.mjs && electron-builder --win nsis --config.forceCodeSigning=false --config.win.signExecutable=false --publish never",
    "dist:dir": "npm run build && node scripts/prepare-licenses.mjs && electron-builder --dir --publish never",
    "test:timeline": "npm run build && node scripts/test-timeline.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.6",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "app.focusreplay.desktop",
    "productName": "FocusReplay",
    "asar": true,
    "asarUnpack": [
      "electron/activity.ps1",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffmpeg-static/ffmpeg.exe.*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": true,
      "signExts": [
        ".dll",
        ".ps1"
      ]
    },
    "portable": {
      "artifactName": "FocusReplay-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "FocusReplay-${version}-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "to": "licenses",
        "from": "licenses"
      }
    ]
  }
}
